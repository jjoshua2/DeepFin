+def stream_hash(source: BinaryIO) -> str:
+    # Keep the repository's Python 3.10 type/API contract (file_digest is newer).
+    digest = hashlib.sha256()
+    while block := source.read(1 << 20):
+        digest.update(block)
+    return digest.hexdigest()
