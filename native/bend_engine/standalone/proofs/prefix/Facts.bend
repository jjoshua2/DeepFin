# Exhaustive key-domain source proofs of independent geometric prefix arithmetic.
# No host-provided prefix table. Each equality is checked against Spec's functions.
import Base
import ./Spec.bend as S
import ../layout/Domain.bend as Domain

def state(+k: Nat) -> Type:
  {U32.is_le(512,S.prefix(k)) == True{} : Bool}
  & {U32.is_lt(S.prefix(k),131072) == True{} : Bool}
  & {U64.from_u32(S.prefix(k)) == S.wide(k) : U64}
  & {U32.and(S.prefix(k),131071) == S.prefix(k) : U32}

