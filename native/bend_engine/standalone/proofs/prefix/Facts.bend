def transition(+k: Nat) -> Type:
  {U32.is_lt(S.prefix(k),S.prefix(1n+k)) == True{} : Bool}
  & {U64.add(U64.from_u32(S.prefix(k)),U64.from_u32(S.size(k))) == U64.from_u32(S.prefix(1n+k)) : U64}

