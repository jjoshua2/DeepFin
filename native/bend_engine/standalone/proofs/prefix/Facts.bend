def lower(-k: Nat, pair: state(k)) -> {U32.is_le(512,S.prefix(k)) == True{} : Bool}:
  (a,rest) = pair
  a

def upper(-k: Nat, pair: state(k)) -> {U32.is_lt(S.prefix(k),131072) == True{} : Bool}:
  (a,(b,rest)) = pair
  b

def wide(-k: Nat, pair: state(k)) -> {U64.from_u32(S.prefix(k)) == S.wide(k) : U64}:
  (a,(b,(c,d))) = pair
  c

def normalized(-k: Nat, pair: state(k)) -> {U32.and(S.prefix(k),131071) == S.prefix(k) : U32}:
  (a,(b,(c,d))) = pair
  d

def increasing(-k: Nat, pair: transition(k)) -> {U32.is_lt(S.prefix(k),S.prefix(1n+k)) == True{} : Bool}:
  (a,b) = pair
  a

def no_wrap(-k: Nat, pair: transition(k)) -> {U64.add(U64.from_u32(S.prefix(k)),U64.from_u32(S.size(k))) == U64.from_u32(S.prefix(1n+k)) : U64}:
  (a,b) = pair
  b
