import Base
import ./Spec.bend as S
import ../layout/Domain.bend as D
import ./Rank0.bend as R0
import ./Rank1.bend as R1
import ./Rank2.bend as R2
import ./Rank3.bend as R3
import ./Rank4.bend as R4
import ./Rank5.bend as R5
import ./Rank6.bend as R6
import ./Rank7.bend as R7

def all(+src: Nat,+dir: Nat,source_bound: {Nat.is_lt(src,64n) == True{} : Bool},direction_bound: {Nat.is_lt(dir,8n) == True{} : Bool}) -> S.certificate(src,dir):
  match src:
    case 0n: R0.square0(dir,direction_bound)
    case 1n: R0.square1(dir,direction_bound)
    case 2n: R0.square2(dir,direction_bound)
    case 3n: R0.square3(dir,direction_bound)
    case 4n: R0.square4(dir,direction_bound)
    case 5n: R0.square5(dir,direction_bound)
    case 6n: R0.square6(dir,direction_bound)
    case 7n: R0.square7(dir,direction_bound)
    case 8n: R1.square8(dir,direction_bound)
    case 9n: R1.square9(dir,direction_bound)
    case 10n: R1.square10(dir,direction_bound)
    case 11n: R1.square11(dir,direction_bound)
    case 12n: R1.square12(dir,direction_bound)
    case 13n: R1.square13(dir,direction_bound)
    case 14n: R1.square14(dir,direction_bound)
    case 15n: R1.square15(dir,direction_bound)
    case 16n: R2.square16(dir,direction_bound)
    case 17n: R2.square17(dir,direction_bound)
    case 18n: R2.square18(dir,direction_bound)
    case 19n: R2.square19(dir,direction_bound)
    case 20n: R2.square20(dir,direction_bound)
    case 21n: R2.square21(dir,direction_bound)
    case 22n: R2.square22(dir,direction_bound)
    case 23n: R2.square23(dir,direction_bound)
    case 24n: R3.square24(dir,direction_bound)
    case 25n: R3.square25(dir,direction_bound)
    case 26n: R3.square26(dir,direction_bound)
    case 27n: R3.square27(dir,direction_bound)
    case 28n: R3.square28(dir,direction_bound)
    case 29n: R3.square29(dir,direction_bound)
    case 30n: R3.square30(dir,direction_bound)
    case 31n: R3.square31(dir,direction_bound)
    case 32n: R4.square32(dir,direction_bound)
    case 33n: R4.square33(dir,direction_bound)
    case 34n: R4.square34(dir,direction_bound)
    case 35n: R4.square35(dir,direction_bound)
    case 36n: R4.square36(dir,direction_bound)
    case 37n: R4.square37(dir,direction_bound)
    case 38n: R4.square38(dir,direction_bound)
    case 39n: R4.square39(dir,direction_bound)
    case 40n: R5.square40(dir,direction_bound)
    case 41n: R5.square41(dir,direction_bound)
    case 42n: R5.square42(dir,direction_bound)
    case 43n: R5.square43(dir,direction_bound)
    case 44n: R5.square44(dir,direction_bound)
    case 45n: R5.square45(dir,direction_bound)
    case 46n: R5.square46(dir,direction_bound)
    case 47n: R5.square47(dir,direction_bound)
    case 48n: R6.square48(dir,direction_bound)
    case 49n: R6.square49(dir,direction_bound)
    case 50n: R6.square50(dir,direction_bound)
    case 51n: R6.square51(dir,direction_bound)
    case 52n: R6.square52(dir,direction_bound)
    case 53n: R6.square53(dir,direction_bound)
    case 54n: R6.square54(dir,direction_bound)
    case 55n: R6.square55(dir,direction_bound)
    case 56n: R7.square56(dir,direction_bound)
    case 57n: R7.square57(dir,direction_bound)
    case 58n: R7.square58(dir,direction_bound)
    case 59n: R7.square59(dir,direction_bound)
    case 60n: R7.square60(dir,direction_bound)
    case 61n: R7.square61(dir,direction_bound)
    case 62n: R7.square62(dir,direction_bound)
    case 63n: R7.square63(dir,direction_bound)
    case 64n+p: D.impossible(S.certificate(64n+p,dir),p,source_bound)
