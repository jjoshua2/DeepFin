# Proof-interface lift of the actual scalar kernel, not a new engine API.
import Base
import ./Spec.bend as S
import ./Clear.bend as Clear
import ../board/Spec.bend as B
import ../ray/Algebra.bend as A
import ../../../legal_probe/Chess.bend as Chess

def run(board: Chess.Board,+mask: U64) -> Chess.Board:
  Chess.Board{p,n,b,r,q,k,w,bl,turn,rights,ep} = board
  Chess.Board{Chess.update_piece(p,mask,U64.zero(),False{}),Chess.update_piece(n,mask,U64.zero(),False{}),Chess.update_piece(b,mask,U64.zero(),False{}),Chess.update_piece(r,mask,U64.zero(),False{}),Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep}

def scalar(+bits: U64,+mask: U64,target: U64) ->
  {Chess.update_piece(bits,mask,target,False{}) == U64.and_not(bits,mask) : U64}:
  A.zero(U64.and_not(bits,mask))

def exact(+board: Chess.Board,+mask: U64) -> {run(board,mask) == S.erase(board,mask) : Chess.Board}:
  match board:
    case Chess.Board{+p,+n,+b,+r,+q,+k,+w,+bl,+turn,+rights,+ep}:
      Equal.trans(Chess.Board,Chess.Board{Chess.update_piece(p,mask,U64.zero(),False{}),Chess.update_piece(n,mask,U64.zero(),False{}),Chess.update_piece(b,mask,U64.zero(),False{}),Chess.update_piece(r,mask,U64.zero(),False{}),Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),Chess.update_piece(n,mask,U64.zero(),False{}),Chess.update_piece(b,mask,U64.zero(),False{}),Chess.update_piece(r,mask,U64.zero(),False{}),Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),U64.and_not(k,mask),U64.and_not(w,mask),U64.and_not(bl,mask),turn,rights,ep},
        Equal.cong(U64,Chess.Board,value => Chess.Board{value,Chess.update_piece(n,mask,U64.zero(),False{}),Chess.update_piece(b,mask,U64.zero(),False{}),Chess.update_piece(r,mask,U64.zero(),False{}),Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.update_piece(p,mask,U64.zero(),False{}),U64.and_not(p,mask),scalar(p,mask,U64.zero())),
        Equal.trans(Chess.Board,Chess.Board{U64.and_not(p,mask),Chess.update_piece(n,mask,U64.zero(),False{}),Chess.update_piece(b,mask,U64.zero(),False{}),Chess.update_piece(r,mask,U64.zero(),False{}),Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),Chess.update_piece(b,mask,U64.zero(),False{}),Chess.update_piece(r,mask,U64.zero(),False{}),Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),U64.and_not(k,mask),U64.and_not(w,mask),U64.and_not(bl,mask),turn,rights,ep},
        Equal.cong(U64,Chess.Board,value => Chess.Board{U64.and_not(p,mask),value,Chess.update_piece(b,mask,U64.zero(),False{}),Chess.update_piece(r,mask,U64.zero(),False{}),Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.update_piece(n,mask,U64.zero(),False{}),U64.and_not(n,mask),scalar(n,mask,U64.zero())),
        Equal.trans(Chess.Board,Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),Chess.update_piece(b,mask,U64.zero(),False{}),Chess.update_piece(r,mask,U64.zero(),False{}),Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),Chess.update_piece(r,mask,U64.zero(),False{}),Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),U64.and_not(k,mask),U64.and_not(w,mask),U64.and_not(bl,mask),turn,rights,ep},
        Equal.cong(U64,Chess.Board,value => Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),value,Chess.update_piece(r,mask,U64.zero(),False{}),Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.update_piece(b,mask,U64.zero(),False{}),U64.and_not(b,mask),scalar(b,mask,U64.zero())),
        Equal.trans(Chess.Board,Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),Chess.update_piece(r,mask,U64.zero(),False{}),Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),U64.and_not(k,mask),U64.and_not(w,mask),U64.and_not(bl,mask),turn,rights,ep},
        Equal.cong(U64,Chess.Board,value => Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),value,Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.update_piece(r,mask,U64.zero(),False{}),U64.and_not(r,mask),scalar(r,mask,U64.zero())),
        Equal.trans(Chess.Board,Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),Chess.update_piece(q,mask,U64.zero(),False{}),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),U64.and_not(k,mask),U64.and_not(w,mask),U64.and_not(bl,mask),turn,rights,ep},
        Equal.cong(U64,Chess.Board,value => Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),value,Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.update_piece(q,mask,U64.zero(),False{}),U64.and_not(q,mask),scalar(q,mask,U64.zero())),
        Equal.trans(Chess.Board,Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),Chess.update_piece(k,mask,U64.zero(),False{}),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),U64.and_not(k,mask),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),U64.and_not(k,mask),U64.and_not(w,mask),U64.and_not(bl,mask),turn,rights,ep},
        Equal.cong(U64,Chess.Board,value => Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),value,Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.update_piece(k,mask,U64.zero(),False{}),U64.and_not(k,mask),scalar(k,mask,U64.zero())),
        Equal.trans(Chess.Board,Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),U64.and_not(k,mask),Chess.update_piece(w,mask,U64.zero(),False{}),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),U64.and_not(k,mask),U64.and_not(w,mask),Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),U64.and_not(k,mask),U64.and_not(w,mask),U64.and_not(bl,mask),turn,rights,ep},
        Equal.cong(U64,Chess.Board,value => Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),U64.and_not(k,mask),value,Chess.update_piece(bl,mask,U64.zero(),False{}),turn,rights,ep},Chess.update_piece(w,mask,U64.zero(),False{}),U64.and_not(w,mask),scalar(w,mask,U64.zero())),
        Equal.cong(U64,Chess.Board,value => Chess.Board{U64.and_not(p,mask),U64.and_not(n,mask),U64.and_not(b,mask),U64.and_not(r,mask),U64.and_not(q,mask),U64.and_not(k,mask),U64.and_not(w,mask),value,turn,rights,ep},Chess.update_piece(bl,mask,U64.zero(),False{}),U64.and_not(bl,mask),scalar(bl,mask,U64.zero())))))))))

def preserves(+board: Chess.Board,+mask: U64,good: {B.valid(board) == True{} : Bool}) -> {B.valid(run(board,mask)) == True{} : Bool}:
  Equal.trans(Bool,B.valid(run(board,mask)),B.valid(S.erase(board,mask)),True{},
    Equal.cong(Chess.Board,Bool,b => B.valid(b),run(board,mask),S.erase(board,mask),exact(board,mask)),Clear.clear(board,mask,good))

def fresh(+board: Chess.Board,+source: U64,+target: U64) -> {B.fresh_mask(run(board,S.removal(source,target)),target) == True{} : Bool}:
  Equal.trans(Bool,B.fresh_mask(run(board,S.removal(source,target)),target),B.fresh_mask(S.erase(board,S.removal(source,target)),target),True{},
    Equal.cong(Chess.Board,Bool,b => B.fresh_mask(b,target),run(board,S.removal(source,target)),S.erase(board,S.removal(source,target)),exact(board,S.removal(source,target))),
    Clear.fresh(board,source,target))
