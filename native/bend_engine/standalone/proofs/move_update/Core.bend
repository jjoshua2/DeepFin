import Base
import ./Spec.bend as S
import ../board/Spec.bend as B
import ../ray/Algebra.bend as A
import ../../Position.bend as Position
import ../../../legal_probe/Chess.bend as Chess

def raw(board: Chess.Board,+mask: U64,+target: U64,+kind: U32,+white: Bool,turn: U32,rights: U32,ep: U32) -> Chess.Board:
  Chess.Board{p,n,b,r,q,k,w,bl,oldturn,oldrights,oldep} = board
  Chess.Board{Chess.update_piece(p,mask,target,U32.is_eq(kind,0)),Chess.update_piece(n,mask,target,U32.is_eq(kind,1)),Chess.update_piece(b,mask,target,U32.is_eq(kind,2)),U64.or(Chess.update_piece(r,mask,target,U32.is_eq(kind,3)),U64.zero()),Chess.update_piece(q,mask,target,U32.is_eq(kind,4)),Chess.update_piece(k,mask,target,U32.is_eq(kind,5)),Chess.update_piece(w,mask,U64.or(target,U64.zero()),white),Chess.update_piece(bl,mask,U64.or(target,U64.zero()),Bool.not(white)),turn,rights,ep}

def assembled(board: Chess.Board,mask: U64,target: U64,piece: B.Piece,white: Bool,turn: U32,rights: U32,ep: U32) -> Chess.Board:
  Position.metadata(B.insert_mask(S.erase(board,mask),target,piece,white),turn,rights,ep)

def bridge(+board: Chess.Board,+mask: U64,+target: U64,+piece: B.Piece,+white: Bool,+turn: U32,+rights: U32,+ep: U32) ->
  {raw(board,mask,target,B.tag(piece),white,turn,rights,ep) == assembled(board,mask,target,piece,white,turn,rights,ep) : Chess.Board}:
  match board white:
    case Chess.Board{+p, +n, +b, +r, +q, +k, +w, +bl,oldturn,oldrights,oldep} False{}:
