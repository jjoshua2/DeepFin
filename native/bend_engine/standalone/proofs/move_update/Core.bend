        Equal.cong(U64,Chess.Board,x => Chess.Board{Chess.update_piece(p,mask,target,U32.is_eq(B.tag(piece),0)),Chess.update_piece(n,mask,target,U32.is_eq(B.tag(piece),1)),Chess.update_piece(b,mask,target,U32.is_eq(B.tag(piece),2)),x,Chess.update_piece(q,mask,target,U32.is_eq(B.tag(piece),4)),Chess.update_piece(k,mask,target,U32.is_eq(B.tag(piece),5)),Chess.update_piece(w,mask,U64.or(target,U64.zero()),False{}),Chess.update_piece(bl,mask,U64.or(target,U64.zero()),Bool.not(False{})),turn,rights,ep},U64.or(Chess.update_piece(r,mask,target,U32.is_eq(B.tag(piece),3)),U64.zero()),Chess.update_piece(r,mask,target,U32.is_eq(B.tag(piece),3)),A.zero(Chess.update_piece(r,mask,target,U32.is_eq(B.tag(piece),3)))),
        Equal.cong(U64,Chess.Board,x => Chess.Board{Chess.update_piece(p,mask,target,U32.is_eq(B.tag(piece),0)),Chess.update_piece(n,mask,target,U32.is_eq(B.tag(piece),1)),Chess.update_piece(b,mask,target,U32.is_eq(B.tag(piece),2)),Chess.update_piece(r,mask,target,U32.is_eq(B.tag(piece),3)),Chess.update_piece(q,mask,target,U32.is_eq(B.tag(piece),4)),Chess.update_piece(k,mask,target,U32.is_eq(B.tag(piece),5)),Chess.update_piece(w,mask,x,False{}),Chess.update_piece(bl,mask,x,Bool.not(False{})),turn,rights,ep},U64.or(target,U64.zero()),target,A.zero(target)))
    case Chess.Board{+p, +n, +b, +r, +q, +k, +w, +bl,oldturn,oldrights,oldep} True{}:
      Equal.trans(Chess.Board,Chess.Board{Chess.update_piece(p,mask,target,U32.is_eq(B.tag(piece),0)),Chess.update_piece(n,mask,target,U32.is_eq(B.tag(piece),1)),Chess.update_piece(b,mask,target,U32.is_eq(B.tag(piece),2)),U64.or(Chess.update_piece(r,mask,target,U32.is_eq(B.tag(piece),3)),U64.zero()),Chess.update_piece(q,mask,target,U32.is_eq(B.tag(piece),4)),Chess.update_piece(k,mask,target,U32.is_eq(B.tag(piece),5)),Chess.update_piece(w,mask,U64.or(target,U64.zero()),True{}),Chess.update_piece(bl,mask,U64.or(target,U64.zero()),Bool.not(True{})),turn,rights,ep},Chess.Board{Chess.update_piece(p,mask,target,U32.is_eq(B.tag(piece),0)),Chess.update_piece(n,mask,target,U32.is_eq(B.tag(piece),1)),Chess.update_piece(b,mask,target,U32.is_eq(B.tag(piece),2)),Chess.update_piece(r,mask,target,U32.is_eq(B.tag(piece),3)),Chess.update_piece(q,mask,target,U32.is_eq(B.tag(piece),4)),Chess.update_piece(k,mask,target,U32.is_eq(B.tag(piece),5)),Chess.update_piece(w,mask,U64.or(target,U64.zero()),True{}),Chess.update_piece(bl,mask,U64.or(target,U64.zero()),Bool.not(True{})),turn,rights,ep},Chess.Board{Chess.update_piece(p,mask,target,U32.is_eq(B.tag(piece),0)),Chess.update_piece(n,mask,target,U32.is_eq(B.tag(piece),1)),Chess.update_piece(b,mask,target,U32.is_eq(B.tag(piece),2)),Chess.update_piece(r,mask,target,U32.is_eq(B.tag(piece),3)),Chess.update_piece(q,mask,target,U32.is_eq(B.tag(piece),4)),Chess.update_piece(k,mask,target,U32.is_eq(B.tag(piece),5)),Chess.update_piece(w,mask,target,True{}),Chess.update_piece(bl,mask,target,Bool.not(True{})),turn,rights,ep},
        Equal.cong(U64,Chess.Board,x => Chess.Board{Chess.update_piece(p,mask,target,U32.is_eq(B.tag(piece),0)),Chess.update_piece(n,mask,target,U32.is_eq(B.tag(piece),1)),Chess.update_piece(b,mask,target,U32.is_eq(B.tag(piece),2)),x,Chess.update_piece(q,mask,target,U32.is_eq(B.tag(piece),4)),Chess.update_piece(k,mask,target,U32.is_eq(B.tag(piece),5)),Chess.update_piece(w,mask,U64.or(target,U64.zero()),True{}),Chess.update_piece(bl,mask,U64.or(target,U64.zero()),Bool.not(True{})),turn,rights,ep},U64.or(Chess.update_piece(r,mask,target,U32.is_eq(B.tag(piece),3)),U64.zero()),Chess.update_piece(r,mask,target,U32.is_eq(B.tag(piece),3)),A.zero(Chess.update_piece(r,mask,target,U32.is_eq(B.tag(piece),3)))),
        Equal.cong(U64,Chess.Board,x => Chess.Board{Chess.update_piece(p,mask,target,U32.is_eq(B.tag(piece),0)),Chess.update_piece(n,mask,target,U32.is_eq(B.tag(piece),1)),Chess.update_piece(b,mask,target,U32.is_eq(B.tag(piece),2)),Chess.update_piece(r,mask,target,U32.is_eq(B.tag(piece),3)),Chess.update_piece(q,mask,target,U32.is_eq(B.tag(piece),4)),Chess.update_piece(k,mask,target,U32.is_eq(B.tag(piece),5)),Chess.update_piece(w,mask,x,True{}),Chess.update_piece(bl,mask,x,Bool.not(True{})),turn,rights,ep},U64.or(target,U64.zero()),target,A.zero(target)))
