# Exhaustive Boolean row cases are checked inside Bend, not assumed.
import Base
import ../board/Spec.bend as B
import ../decoder/Spec.bend as D
import ../u64/Words.bend as Old

def king(r: B.Row) -> Bool:
  B.Row{p,n,b,ro,q,k,w,bl} = r
  k

def not_true_is_false(+b: Bool,e: {Bool.not(Bool.and(b,True{})) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case False{}: {==}
    case True{}: Old.false_true({True{} == False{} : Bool},e)

def kind(+row: B.Row,good: {B.row_valid(row) == True{} : Bool},present: {king(row) == True{} : Bool}) ->
  {D.selected_tag(row) == 5 : U32}:
  match row:
    case B.Row{False{},False{},False{},False{},False{},False{},False{},False{}}: Old.false_true({D.selected_tag(B.Row{False{},False{},False{},False{},False{},False{},False{},False{}}) == 5 : U32},present)
    case B.Row{False{},False{},False{},False{},False{},False{},False{},True{}}: Old.false_true({D.selected_tag(B.Row{False{},False{},False{},False{},False{},False{},False{},True{}}) == 5 : U32},good)
    case B.Row{False{},False{},False{},False{},False{},False{},True{},False{}}: Old.false_true({D.selected_tag(B.Row{False{},False{},False{},False{},False{},False{},True{},False{}}) == 5 : U32},good)
