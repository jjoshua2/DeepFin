    case B.Row{False{},False{},False{},False{},False{},True{},False{},True{}}: {==}
    case B.Row{False{},False{},False{},False{},False{},True{},True{},False{}}: {==}
    case B.Row{False{},False{},False{},False{},False{},True{},True{},True{}}: Old.false_true({D.selected_tag(B.Row{False{},False{},False{},False{},False{},True{},True{},True{}}) == 5 : U32},good)
    case B.Row{False{},False{},False{},False{},True{},False{},False{},False{}}: Old.false_true({D.selected_tag(B.Row{False{},False{},False{},False{},True{},False{},False{},False{}}) == 5 : U32},good)
    case B.Row{False{},False{},False{},False{},True{},False{},False{},True{}}: Old.false_true({D.selected_tag(B.Row{False{},False{},False{},False{},True{},False{},False{},True{}}) == 5 : U32},present)
