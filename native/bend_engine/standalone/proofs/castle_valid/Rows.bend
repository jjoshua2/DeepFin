def side(row: Board.Row,s: U32) -> Bool:
  Board.Row{p,n,b,r,q,k,w,bl}=row
  Bool.pick(Bool,U32.is_eq(s,1),w,bl)
def occupied(+row: Board.Row,+p: U32,s: U32) -> Bool:
  Bool.and(side(row,s),U32.is_eq(Row.selected_tag(row),p))
def occupied_exact(+b: Chess.Board,+sq: U32,+p: U32,+s: U32) ->
  {Pos.occupied_by(b,sq,p,s) == occupied(Row.row(b,sq),p,s) : Bool}:
  Equal.cong(Bool,Bool,x => Bool.and(x,U32.is_eq(Chess.piece(b,sq),p)),
    U64.test_bit(Chess.color(b,s),U32.to_nat(sq)),side(Row.row(b,sq),s),
    Source.pick_test(Chess.get_white(b),Chess.get_black(b),U32.to_nat(sq),U32.is_eq(s,1)))
def occupant(+b: Chess.Board,+m: Chess.Ply,+sq: U32,+p: U32,+s: U32,
  same: {Row.row(Chess.make_move(b,m),sq) == Row.row(b,sq) : Board.Row}) ->
  {Pos.occupied_by(Chess.make_move(b,m),sq,p,s) == Pos.occupied_by(b,sq,p,s) : Bool}:
  Equal.trans(Bool,Pos.occupied_by(Chess.make_move(b,m),sq,p,s),occupied(Row.row(Chess.make_move(b,m),sq),p,s),Pos.occupied_by(b,sq,p,s),occupied_exact(Chess.make_move(b,m),sq,p,s),
    Equal.trans(Bool,occupied(Row.row(Chess.make_move(b,m),sq),p,s),occupied(Row.row(b,sq),p,s),Pos.occupied_by(b,sq,p,s),
      Equal.cong(Board.Row,Bool,x => occupied(x,p,s),Row.row(Chess.make_move(b,m),sq),Row.row(b,sq),same),Equal.sym(Bool,Pos.occupied_by(b,sq,p,s),occupied(Row.row(b,sq),p,s),occupied_exact(b,sq,p,s))))
