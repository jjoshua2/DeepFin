    case 9n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),9),range)
    case 10n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),10),range)
    case 11n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),11),range)
