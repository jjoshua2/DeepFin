    case 5n 7n: L.impossible(slash_statement(5,7),fit)
    case 5n 8n+p: D.impossible(slash_statement(5,U32.from_nat(8n+p)),p,rb)
    case 6n 0n: L.impossible(slash_statement(6,0),fit)
    case 6n 1n: L.impossible(slash_statement(6,1),fit)
    case 6n 2n: L.impossible(slash_statement(6,2),fit)
    case 6n 3n: L.impossible(slash_statement(6,3),fit)
    case 6n 4n: L.impossible(slash_statement(6,4),fit)
    case 6n 5n: L.impossible(slash_statement(6,5),fit)
    case 6n 6n: L.impossible(slash_statement(6,6),fit)
    case 6n 7n: L.impossible(slash_statement(6,7),fit)
    case 6n 8n+p: D.impossible(slash_statement(6,U32.from_nat(8n+p)),p,rb)
    case 7n 0n: L.impossible(slash_statement(7,0),fit)
    case 7n 1n: L.impossible(slash_statement(7,1),fit)
    case 7n 2n: L.impossible(slash_statement(7,2),fit)
    case 7n 3n: L.impossible(slash_statement(7,3),fit)
    case 7n 4n: L.impossible(slash_statement(7,4),fit)
