    case 3n 6n: L.impossible(slash_statement(3,6),fit)
    case 3n 7n: L.impossible(slash_statement(3,7),fit)
    case 3n 8n+p: D.impossible(slash_statement(3,U32.from_nat(8n+p)),p,rb)
    case 4n 0n: L.impossible(slash_statement(4,0),fit)
    case 4n 1n: L.impossible(slash_statement(4,1),fit)
    case 4n 2n: L.impossible(slash_statement(4,2),fit)
    case 4n 3n: L.impossible(slash_statement(4,3),fit)
    case 4n 4n: L.impossible(slash_statement(4,4),fit)
    case 4n 5n: L.impossible(slash_statement(4,5),fit)
    case 4n 6n: L.impossible(slash_statement(4,6),fit)
