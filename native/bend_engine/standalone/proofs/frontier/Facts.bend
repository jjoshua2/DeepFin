    case 35n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),35),range)
    case 36n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),36),range)
    case 37n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),37),range)
    case 38n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),38),range)
    case 39n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),39),range)
