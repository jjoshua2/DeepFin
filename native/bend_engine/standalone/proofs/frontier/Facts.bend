    case 7n 8n+p: D.impossible(slash_statement(7,U32.from_nat(8n+p)),p,rb)
    case 8n 0n: L.impossible(slash_statement(8,0),fit)
    case 8n 1n: ({==},{==})
    case 8n 2n: ({==},{==})
    case 8n 3n: ({==},{==})
    case 8n 4n: ({==},{==})
    case 8n 5n: ({==},{==})
    case 8n 6n: ({==},{==})
    case 8n 7n: ({==},{==})
    case 8n 8n+p: D.impossible(slash_statement(8,U32.from_nat(8n+p)),p,rb)
    case 9n+p _: D.impossible(slash_statement(U32.from_nat(9n+p),U32.from_nat(r)),p,fb)

def slash(+f: U32,+r: U32,+bound: {S.bounds(f,r) == True{} : Bool},
  fit: {Bool.and(U32.is_eq(f,8),U32.is_gt(r,0)) == True{} : Bool}) -> slash_statement(f,r):
  Finite.u9(f,L.left(Nat.is_lt(U32.to_nat(f),9n),Nat.is_lt(U32.to_nat(r),8n),bound),
    x => {Bool.and(U32.is_eq(x,8),U32.is_gt(r,0)) == True{} : Bool} -> slash_statement(x,r),
    +fn => fb => +fit =>
      Finite.u8(r,L.right(Nat.is_lt(U32.to_nat(f),9n),Nat.is_lt(U32.to_nat(r),8n),bound),
        y => {Bool.and(U32.is_eq(U32.from_nat(fn),8),U32.is_gt(y,0)) == True{} : Bool} -> slash_statement(U32.from_nat(fn),y),
        rn => rb => fit => slash_nat(fn,rn,fb,rb,fit))(fit))(fit)
