    case 1n 5n: L.impossible(slash_statement(1,5),fit)
    case 1n 6n: L.impossible(slash_statement(1,6),fit)
    case 1n 7n: L.impossible(slash_statement(1,7),fit)
    case 1n 8n+p: D.impossible(slash_statement(1,U32.from_nat(8n+p)),p,rb)
    case 2n 0n: L.impossible(slash_statement(2,0),fit)
    case 2n 1n: L.impossible(slash_statement(2,1),fit)
    case 2n 2n: L.impossible(slash_statement(2,2),fit)
    case 2n 3n: L.impossible(slash_statement(2,3),fit)
