    case 41n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),41),range)
    case 42n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),42),range)
    case 43n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),43),range)
    case 44n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),44),range)
