    case 22n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),22),range)
    case 23n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),23),range)
    case 24n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),24),range)
    case 25n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),25),range)
    case 26n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),26),range)
    case 27n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),27),range)
    case 28n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),28),range)
