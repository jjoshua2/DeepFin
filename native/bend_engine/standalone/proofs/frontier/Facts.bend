    case 2n 0n: ({==},{==})
    case 2n 1n: ({==},{==})
    case 2n 2n: ({==},{==})
    case 2n 3n: ({==},{==})
    case 2n 4n: ({==},{==})
    case 2n 5n: ({==},{==})
    case 2n 6n: ({==},{==})
    case 2n 7n: ({==},{==})
    case 2n 8n+p: D.impossible(digit_statement(2,U32.from_nat(8n+p),49),p,rb)
    case 3n 0n: ({==},{==})
    case 3n 1n: ({==},{==})
    case 3n 2n: ({==},{==})
    case 3n 3n: ({==},{==})
    case 3n 4n: ({==},{==})
    case 3n 5n: ({==},{==})
    case 3n 6n: ({==},{==})
    case 3n 7n: ({==},{==})
    case 3n 8n+p: D.impossible(digit_statement(3,U32.from_nat(8n+p),49),p,rb)
    case 4n 0n: ({==},{==})
    case 4n 1n: ({==},{==})
    case 4n 2n: ({==},{==})
    case 4n 3n: ({==},{==})
    case 4n 4n: ({==},{==})
    case 4n 5n: ({==},{==})
    case 4n 6n: ({==},{==})
    case 4n 7n: ({==},{==})
    case 4n 8n+p: D.impossible(digit_statement(4,U32.from_nat(8n+p),49),p,rb)
    case 5n 0n: ({==},{==})
    case 5n 1n: ({==},{==})
    case 5n 2n: ({==},{==})
    case 5n 3n: ({==},{==})
    case 5n 4n: ({==},{==})
    case 5n 5n: ({==},{==})
    case 5n 6n: ({==},{==})
    case 5n 7n: ({==},{==})
    case 5n 8n+p: D.impossible(digit_statement(5,U32.from_nat(8n+p),49),p,rb)
    case 6n 0n: ({==},{==})
    case 6n 1n: ({==},{==})
    case 6n 2n: ({==},{==})
    case 6n 3n: ({==},{==})
    case 6n 4n: ({==},{==})
    case 6n 5n: ({==},{==})
    case 6n 6n: ({==},{==})
    case 6n 7n: ({==},{==})
    case 6n 8n+p: D.impossible(digit_statement(6,U32.from_nat(8n+p),49),p,rb)
    case 7n 0n: ({==},{==})
    case 7n 1n: ({==},{==})
    case 7n 2n: ({==},{==})
    case 7n 3n: ({==},{==})
    case 7n 4n: ({==},{==})
    case 7n 5n: ({==},{==})
    case 7n 6n: ({==},{==})
    case 7n 7n: ({==},{==})
    case 7n 8n+p: D.impossible(digit_statement(7,U32.from_nat(8n+p),49),p,rb)
    case 8n 0n: L.impossible(digit_statement(8,0,49),fit)
    case 8n 1n: L.impossible(digit_statement(8,1,49),fit)
    case 8n 2n: L.impossible(digit_statement(8,2,49),fit)
