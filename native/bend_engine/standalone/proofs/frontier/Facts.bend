    case 52n: digit4(f,r,fb,rb,fit)
    case 53n: digit5(f,r,fb,rb,fit)
    case 54n: digit6(f,r,fb,rb,fit)
    case 55n: digit7(f,r,fb,rb,fit)
    case 56n: digit8(f,r,fb,rb,fit)
    case 57n+p: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),U32.from_nat(57n+p)),cb)

def digit(+c: U32,+f: U32,+r: U32,+bound: {S.bounds(f,r) == True{} : Bool},
  +range: {S.digit(c) == True{} : Bool},fit: {U32.is_le(U32.add(f,U32.sub(c,48)),8) == True{} : Bool}) ->
  digit_statement(f,r,c):
  Finite.u57(c,Finite.le_nat(c,56,L.right(U32.is_ge(c,49),U32.is_le(c,56),range)),
    z => {S.digit(z) == True{} : Bool} -> {U32.is_le(U32.add(f,U32.sub(z,48)),8) == True{} : Bool} -> digit_statement(f,r,z),
    +cn => cb => +rg => +fit =>
      Finite.u9(f,L.left(Nat.is_lt(U32.to_nat(f),9n),Nat.is_lt(U32.to_nat(r),8n),bound),
        x => {U32.is_le(U32.add(x,U32.sub(U32.from_nat(cn),48)),8) == True{} : Bool} -> digit_statement(x,r,U32.from_nat(cn)),
        +fn => fb => +fit =>
          Finite.u8(r,L.right(Nat.is_lt(U32.to_nat(f),9n),Nat.is_lt(U32.to_nat(r),8n),bound),
            y => digit_statement(U32.from_nat(fn),y,U32.from_nat(cn)),
            rn => rb => digit_nat(cn,fn,rn,cb,fb,rb,rg,fit)))(fit))(range)(fit)

def slash_statement(+f: U32,+r: U32) -> Type:
  {S.bounds(0,U32.sub(r,1)) == True{} : Bool} &
  {L.subset(S.pending(0,U32.sub(r,1)),S.pending(f,r)) == True{} : Bool}

def slash_nat(+f: Nat,+r: Nat,fb: {Nat.is_lt(f,9n) == True{} : Bool},rb: {Nat.is_lt(r,8n) == True{} : Bool},
  fit: {Bool.and(U32.is_eq(U32.from_nat(f),8),U32.is_gt(U32.from_nat(r),0)) == True{} : Bool}) ->
  slash_statement(U32.from_nat(f),U32.from_nat(r)):
  match f r:
    case 0n 0n: L.impossible(slash_statement(0,0),fit)
    case 0n 1n: L.impossible(slash_statement(0,1),fit)
    case 0n 2n: L.impossible(slash_statement(0,2),fit)
    case 0n 3n: L.impossible(slash_statement(0,3),fit)
