def digit4(+f: Nat,+r: Nat,fb: {Nat.is_lt(f,9n) == True{} : Bool},rb: {Nat.is_lt(r,8n) == True{} : Bool},
  fit: {U32.is_le(U32.add(U32.from_nat(f),4),8) == True{} : Bool}) ->
