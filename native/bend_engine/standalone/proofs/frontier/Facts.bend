    case 2n 8n+p: D.impossible(slash_statement(2,U32.from_nat(8n+p)),p,rb)
    case 3n 0n: L.impossible(slash_statement(3,0),fit)
    case 3n 1n: L.impossible(slash_statement(3,1),fit)
    case 3n 2n: L.impossible(slash_statement(3,2),fit)
