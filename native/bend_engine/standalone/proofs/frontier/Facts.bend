# Closed scalar arithmetic/mask certificates, checked inside Bend.
import Base
import ./Spec.bend as S
import ./Logic.bend as L
import ./Finite.bend as Finite
import ../layout/Domain.bend as D

def piece_statement(+f: U32,+r: U32) -> Type:
  {S.bounds(U32.inc(f),r) == True{} : Bool} &
  ({L.subset(S.pending(U32.inc(f),r),S.pending(f,r)) == True{} : Bool} &
  ({L.subset(U64.bit(U32.to_nat(S.square(f,r))),S.pending(f,r)) == True{} : Bool} &
  ({L.disjoint(U64.bit(U32.to_nat(S.square(f,r))),S.pending(U32.inc(f),r)) == True{} : Bool} &
  {Nat.is_lt(U32.to_nat(S.square(f,r)),64n) == True{} : Bool})))

def piece_nat(+f: Nat,+r: Nat,fb: {Nat.is_lt(f,9n) == True{} : Bool},
  rb: {Nat.is_lt(r,8n) == True{} : Bool},fit: {U32.is_lt(U32.from_nat(f),8) == True{} : Bool}) ->
  piece_statement(U32.from_nat(f),U32.from_nat(r)):
  match f r:
    case 0n 0n: ({==},({==},({==},({==},{==}))))
    case 0n 1n: ({==},({==},({==},({==},{==}))))
    case 0n 2n: ({==},({==},({==},({==},{==}))))
    case 0n 3n: ({==},({==},({==},({==},{==}))))
    case 0n 4n: ({==},({==},({==},({==},{==}))))
    case 0n 5n: ({==},({==},({==},({==},{==}))))
    case 0n 6n: ({==},({==},({==},({==},{==}))))
    case 0n 7n: ({==},({==},({==},({==},{==}))))
    case 0n 8n+p: D.impossible(piece_statement(0,U32.from_nat(8n+p)),p,rb)
    case 1n 0n: ({==},({==},({==},({==},{==}))))
    case 1n 1n: ({==},({==},({==},({==},{==}))))
    case 1n 2n: ({==},({==},({==},({==},{==}))))
    case 1n 3n: ({==},({==},({==},({==},{==}))))
    case 1n 4n: ({==},({==},({==},({==},{==}))))
    case 1n 5n: ({==},({==},({==},({==},{==}))))
    case 1n 6n: ({==},({==},({==},({==},{==}))))
    case 1n 7n: ({==},({==},({==},({==},{==}))))
    case 1n 8n+p: D.impossible(piece_statement(1,U32.from_nat(8n+p)),p,rb)
    case 2n 0n: ({==},({==},({==},({==},{==}))))
    case 2n 1n: ({==},({==},({==},({==},{==}))))
    case 2n 2n: ({==},({==},({==},({==},{==}))))
    case 2n 3n: ({==},({==},({==},({==},{==}))))
    case 2n 4n: ({==},({==},({==},({==},{==}))))
    case 2n 5n: ({==},({==},({==},({==},{==}))))
    case 2n 6n: ({==},({==},({==},({==},{==}))))
    case 2n 7n: ({==},({==},({==},({==},{==}))))
    case 2n 8n+p: D.impossible(piece_statement(2,U32.from_nat(8n+p)),p,rb)
    case 3n 0n: ({==},({==},({==},({==},{==}))))
    case 3n 1n: ({==},({==},({==},({==},{==}))))
    case 3n 2n: ({==},({==},({==},({==},{==}))))
    case 3n 3n: ({==},({==},({==},({==},{==}))))
    case 3n 4n: ({==},({==},({==},({==},{==}))))
    case 3n 5n: ({==},({==},({==},({==},{==}))))
    case 3n 6n: ({==},({==},({==},({==},{==}))))
    case 3n 7n: ({==},({==},({==},({==},{==}))))
    case 3n 8n+p: D.impossible(piece_statement(3,U32.from_nat(8n+p)),p,rb)
    case 4n 0n: ({==},({==},({==},({==},{==}))))
    case 4n 1n: ({==},({==},({==},({==},{==}))))
    case 4n 2n: ({==},({==},({==},({==},{==}))))
    case 4n 3n: ({==},({==},({==},({==},{==}))))
    case 4n 4n: ({==},({==},({==},({==},{==}))))
    case 4n 5n: ({==},({==},({==},({==},{==}))))
    case 4n 6n: ({==},({==},({==},({==},{==}))))
    case 4n 7n: ({==},({==},({==},({==},{==}))))
    case 4n 8n+p: D.impossible(piece_statement(4,U32.from_nat(8n+p)),p,rb)
    case 5n 0n: ({==},({==},({==},({==},{==}))))
    case 5n 1n: ({==},({==},({==},({==},{==}))))
    case 5n 2n: ({==},({==},({==},({==},{==}))))
    case 5n 3n: ({==},({==},({==},({==},{==}))))
    case 5n 4n: ({==},({==},({==},({==},{==}))))
    case 5n 5n: ({==},({==},({==},({==},{==}))))
    case 5n 6n: ({==},({==},({==},({==},{==}))))
    case 5n 7n: ({==},({==},({==},({==},{==}))))
    case 5n 8n+p: D.impossible(piece_statement(5,U32.from_nat(8n+p)),p,rb)
    case 6n 0n: ({==},({==},({==},({==},{==}))))
    case 6n 1n: ({==},({==},({==},({==},{==}))))
    case 6n 2n: ({==},({==},({==},({==},{==}))))
    case 6n 3n: ({==},({==},({==},({==},{==}))))
    case 6n 4n: ({==},({==},({==},({==},{==}))))
    case 6n 5n: ({==},({==},({==},({==},{==}))))
    case 6n 6n: ({==},({==},({==},({==},{==}))))
    case 6n 7n: ({==},({==},({==},({==},{==}))))
    case 6n 8n+p: D.impossible(piece_statement(6,U32.from_nat(8n+p)),p,rb)
    case 7n 0n: ({==},({==},({==},({==},{==}))))
    case 7n 1n: ({==},({==},({==},({==},{==}))))
    case 7n 2n: ({==},({==},({==},({==},{==}))))
    case 7n 3n: ({==},({==},({==},({==},{==}))))
    case 7n 4n: ({==},({==},({==},({==},{==}))))
    case 7n 5n: ({==},({==},({==},({==},{==}))))
    case 7n 6n: ({==},({==},({==},({==},{==}))))
    case 7n 7n: ({==},({==},({==},({==},{==}))))
    case 7n 8n+p: D.impossible(piece_statement(7,U32.from_nat(8n+p)),p,rb)
    case 8n 0n: L.impossible(piece_statement(8,0),fit)
    case 8n 1n: L.impossible(piece_statement(8,1),fit)
    case 8n 2n: L.impossible(piece_statement(8,2),fit)
    case 8n 3n: L.impossible(piece_statement(8,3),fit)
    case 8n 4n: L.impossible(piece_statement(8,4),fit)
    case 8n 5n: L.impossible(piece_statement(8,5),fit)
    case 8n 6n: L.impossible(piece_statement(8,6),fit)
    case 8n 7n: L.impossible(piece_statement(8,7),fit)
    case 8n 8n+p: D.impossible(piece_statement(8,U32.from_nat(8n+p)),p,rb)
    case 9n+p _: D.impossible(piece_statement(U32.from_nat(9n+p),U32.from_nat(r)),p,fb)

def piece(+f: U32,+r: U32,+bound: {S.bounds(f,r) == True{} : Bool},
  fit: {U32.is_lt(f,8) == True{} : Bool}) -> piece_statement(f,r):
  Finite.u9(f,L.left(Nat.is_lt(U32.to_nat(f),9n),Nat.is_lt(U32.to_nat(r),8n),bound),
    x => {U32.is_lt(x,8) == True{} : Bool} -> piece_statement(x,r),
    +fn => fb => +fit => Finite.u8(r,L.right(Nat.is_lt(U32.to_nat(f),9n),Nat.is_lt(U32.to_nat(r),8n),bound),
      y => piece_statement(U32.from_nat(fn),y),
      rn => rb => piece_nat(fn,rn,fb,rb,fit)))(fit)

def digit_statement(+f: U32,+r: U32,+c: U32) -> Type:
  {S.bounds(U32.add(f,U32.sub(c,48)),r) == True{} : Bool} &
  {L.subset(S.pending(U32.add(f,U32.sub(c,48)),r),S.pending(f,r)) == True{} : Bool}

