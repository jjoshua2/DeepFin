def digit_nat(+c: Nat,+f: Nat,+r: Nat,cb: {Nat.is_le(c,56n) == True{} : Bool},
  fb: {Nat.is_lt(f,9n) == True{} : Bool},rb: {Nat.is_lt(r,8n) == True{} : Bool},
  range: {S.digit(U32.from_nat(c)) == True{} : Bool},
  fit: {U32.is_le(U32.add(U32.from_nat(f),U32.sub(U32.from_nat(c),48)),8) == True{} : Bool}) ->
  digit_statement(U32.from_nat(f),U32.from_nat(r),U32.from_nat(c)):
  match c:
    case 0n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),0),range)
    case 1n: L.impossible(digit_statement(U32.from_nat(f),U32.from_nat(r),1),range)
