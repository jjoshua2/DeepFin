def key_bound(+k: Nat,p: bounds(k)) -> {U32.is_lt(key(k),256) == True{} : Bool}:
  (kb,rest) = p
  kb

def offset_bound(+k: Nat,p: bounds(k)) -> {U32.is_lt(offset(k),256) == True{} : Bool}:
  (kb,(ob,ne)) = p
  ob
