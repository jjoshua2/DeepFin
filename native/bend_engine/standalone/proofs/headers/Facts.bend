# Finite header-address facts, no external answer table or assumed array values.
import Base
import ../layout/Domain.bend as Domain

def key(k: Nat) -> U32: U32.from_nat(k)
def offset(k: Nat) -> U32: U32.add(128,key(k))

def bounds(+k: Nat) -> Type:
  {U32.is_lt(key(k),256) == True{} : Bool}
  & {U32.is_lt(offset(k),256) == True{} : Bool}
  & {U32.is_eq(offset(k),key(k)) == False{} : Bool}

def facts(+k: Nat,e: {Nat.is_lt(k,128n) == True{} : Bool}) -> bounds(k):
