import Base
import ./Fields.bend as Fields
import ./Emission.bend as Emission
import ./Scan.bend as Scan
import ./Generated.bend as Generated
import ./Bypass.bend as Bypass
import ../castle_chain/Spec.bend as Chain
import ../castle_emission/Spec.bend as E
import ../castle_safety/Spec.bend as Sensitive
import ../castle_safety/Mask.bend as Mask
import ../promotion/Spec.bend as Promotion
import ../../Position.bend as Position
import ../../../legal_probe/Chess.bend as Chess

# Arbitrary actual tables and raw boards. These conclusions describe fields only.
def scan_fields(table: Array<U64>,+b: Chess.Board) ->
  Chain.every(m => Fields.scanned(m),E.moves(Chain.candidates(table,b))):
  Scan.candidates(table,b)

def prefilter_fields(table: Array<U64>,+b: Chess.Board) ->
  Chain.every(m => Fields.generated(b,m),E.moves(Generated.produced(table,b))):
  Generated.all_prefilter(table,b)

def legal_fields(table: Array<U64>,+b: Chess.Board) ->
  Chain.every(m => Fields.generated(b,m),E.moves(Chess.legal_moves(table,b))):
  Generated.all_legal(table,b)

def prefilter_bypass(table: Array<U64>,+b: Chess.Board,+rays: U64,+m: Chess.Ply,
  here: E.member(m,E.moves(Generated.produced(table,b))),
  bypass: {Chess.filter_requires(Sensitive.sensitive(b,rays),m) == False{} : Bool}) -> Fields.bypass_shape(m):
  Bypass.prefilter(table,b,rays,m,here,bypass)

def legal_bypass(table: Array<U64>,+b: Chess.Board,+rays: U64,+m: Chess.Ply,
  here: E.member(m,E.moves(Chess.legal_moves(table,b))),
  bypass: {Chess.filter_requires(Sensitive.sensitive(b,rays),m) == False{} : Bool}) -> Fields.bypass_shape(m):
  Bypass.legal(table,b,rays,m,here,bypass)

def owned_king_forces(+b: Chess.Board,+rays: U64,+src: U32,+dst: U32,+promotion: U32,+flag: U32,
  bound: {Nat.is_lt(U32.to_nat(src),64n) == True{} : Bool},
  owned: {Sensitive.owned_king(b,src) == True{} : Bool}) ->
  {Chess.filter_requires(Sensitive.sensitive(b,rays),Chess.Ply{src,dst,promotion,flag}) == True{} : Bool}:
  Mask.owned(b,rays,src,dst,promotion,flag,bound,owned)

# Repeated preexisting entries are not assumed generated by this scan.
# Their exact occurrence-level field certificate is supplied separately.
def duplicate_tail() -> List<&2,Chess.Ply>:
  Chess.Ply{2,18,0,0} <> Chess.Ply{2,18,0,0} <> Nil{}

def tail_fields() -> Chain.every(m => Fields.scanned(m),duplicate_tail()):
  (Inl{(2,(18,{==}))},(Inl{(2,(18,{==}))},Unit{}))

def multi_targets() -> U64:
  U64.or(U64.bit(10n),U64.or(U64.bit(18n),U64.bit(56n)))

def multi_after_fields() ->
  Chain.every(m => Fields.scanned(m),E.moves(Chess.scan_after(2,True{},10,duplicate_tail(),(ALeaf{U64.bit(63n)},multi_targets())))):
  Scan.after(r => Chain.every(m => Fields.scanned(m),E.moves(r)),2,True{},10,duplicate_tail(),
    (ALeaf{U64.bit(63n)},multi_targets()),tail_fields(),r => good => good)

def multi_after_exact() ->
  {Chess.scan_after(2,True{},10,duplicate_tail(),(ALeaf{U64.bit(63n)},multi_targets())) ==
    (ALeaf{U64.bit(63n)},Chess.Ply{2,56,1,0} <> Chess.Ply{2,56,2,0} <> Chess.Ply{2,56,3,0} <> Chess.Ply{2,56,4,0} <>
      Chess.Ply{2,18,0,0} <> Chess.Ply{2,10,0,1} <> duplicate_tail()) : Array<U64> & List<&2,Chess.Ply>}:
  {==}

def promotion_overrides_ep() ->
  {Chess.scan_after(2,True{},56,duplicate_tail(),(ALeaf{U64.bit(63n)},U64.bit(56n))) ==
    (ALeaf{U64.bit(63n)},List.append(&2,Chess.Ply,Promotion.choices(2,56),duplicate_tail())) : Array<U64> & List<&2,Chess.Ply>}:
  {==}

def zero_fuel() ->
  {Chess.destinations(0n,False{},multi_targets(),2,True{},10,duplicate_tail()) == duplicate_tail() : List<&2,Chess.Ply>}:
  {==}

def explicit_empty() ->
  {Chess.destinations(64n,True{},multi_targets(),2,True{},10,duplicate_tail()) == duplicate_tail() : List<&2,Chess.Ply>}:
  {==}

# Caller tails need their own certificate: scan does not sanitize arbitrary fields.
def unclassified_tail_survives() ->
  {Chess.scan_after(2,True{},10,Chess.Ply{99,100,99,99} <> Nil{},(ALeaf{U64.zero()},U64.zero())) ==
    (ALeaf{U64.zero()},Chess.Ply{99,100,99,99} <> Nil{}) : Array<U64> & List<&2,Chess.Ply>}:
  {==}

# Arbitrary zero attack table: these are implementation outputs, not geometry.
def fixture_board() -> Chess.Board:
  Position.metadata(Position.put(0,True{},49,
    Position.put(5,False{},60,Position.put(5,True{},4,
      Position.put(3,True{},0,Position.put(3,True{},7,Position.empty()))))),1,3,64)

def fixture_prefilter() ->
  {Generated.produced(ALeaf{U64.zero()},fixture_board()) ==
    (ALeaf{U64.zero()},Chess.Ply{4,2,0,2} <> Chess.Ply{4,6,0,2} <> Promotion.choices(49,57)) : Array<U64> & List<&2,Chess.Ply>}:
  {==}

def fixture_legal_order() ->
  {Chess.legal_moves(ALeaf{U64.zero()},fixture_board()) ==
    (ALeaf{U64.zero()},Chess.Ply{49,57,4,0} <> Chess.Ply{49,57,3,0} <> Chess.Ply{49,57,2,0} <> Chess.Ply{49,57,1,0} <>
      Chess.Ply{4,6,0,2} <> Chess.Ply{4,2,0,2} <> Nil{}) : Array<U64> & List<&2,Chess.Ply>}:
  {==}

def fixture_promotion_member(+choice: Promotion.Choice) ->
  E.member(Promotion.ply(49,57,choice),E.moves(Generated.produced(ALeaf{U64.zero()},fixture_board()))):
  match choice:
    case Promotion.Knight{}: Inr{Inr{Inl{{==}}}}
    case Promotion.Bishop{}: Inr{Inr{Inr{Inl{{==}}}}}
    case Promotion.Rook{}: Inr{Inr{Inr{Inr{Inl{{==}}}}}}
    case Promotion.Queen{}: Inr{Inr{Inr{Inr{Inr{Inl{{==}}}}}}}

def fixture_promotion_bypass(+choice: Promotion.Choice) -> Fields.bypass_shape(Promotion.ply(49,57,choice)):
  prefilter_bypass(ALeaf{U64.zero()},fixture_board(),U64.zero(),Promotion.ply(49,57,choice),fixture_promotion_member(choice),{==})

def fixture_castle_required() ->
  {Chess.filter_requires(Sensitive.sensitive(fixture_board(),U64.zero()),Chess.Ply{4,6,0,2}) == True{} : Bool}:
  Mask.certificate(fixture_board(),Chess.Ply{4,6,0,2},U64.zero(),Inl{({==},{==})})

def raw_flag_two_can_bypass() ->
  {Chess.filter_requires(Sensitive.sensitive(Position.empty(),U64.zero()),Chess.Ply{4,6,0,2}) == False{} : Bool}:
  {==}

def ep_forces_any_promotion(+promotion: U32) ->
  {Chess.filter_requires(U64.zero(),Chess.Ply{2,10,promotion,1}) == True{} : Bool}:
  {==}

def high_king_forces_any_fields(+promotion: U32,+flag: U32) ->
  {Chess.filter_requires(Sensitive.sensitive(Position.metadata(Position.put(5,False{},63,Position.empty()),0,0,64),U64.zero()),
    Chess.Ply{63,62,promotion,flag}) == True{} : Bool}:
  owned_king_forces(Position.metadata(Position.put(5,False{},63,Position.empty()),0,0,64),U64.zero(),63,62,promotion,flag,{==},{==})
