def valid(+board: Chess.Board,+sq: U32,good: {B.valid(board) == True{} : Bool},
  bound: {Nat.is_lt(U32.to_nat(sq),64n) == True{} : Bool}) ->
  {B.row_valid(S.row(board,sq)) == True{} : Bool}:
  Equal.trans(Bool,B.row_valid(S.row(board,sq)),B.row_valid(S.structural(board,sq)),True{},
    Equal.cong(B.Row,Bool,row => B.row_valid(row),S.row(board,sq),S.structural(board,sq),observations(board,sq,bound)),structural(board,sq,good))
