import Base
import ./Spec.bend as S
import ./Bits.bend as Bits
import ../board/Spec.bend as B
import ../ray/Frame.bend as F
import ../../../legal_probe/Chess.bend as Chess

def project(+width: Nat,+p: Word(width),+n: Word(width),+b: Word(width),+r: Word(width),+q: Word(width),+k: Word(width),+w: Word(width),+bl: Word(width),+i: Nat,
  +good: {B.words(width,p,n,b,r,q,k,w,bl) == True{} : Bool}) ->
  {B.row_valid(S.word_row(width,p,n,b,r,q,k,w,bl,i)) == True{} : Bool}:
  match width:
    case 0n: {==}
    case 1n+t:
      match p n b r q k w bl i:
        case WCon{+ph,+pt} WCon{+nh,+nt} WCon{+bh,+bt} WCon{+rh,+rt} WCon{+qh,+qt} WCon{+kh,+kt} WCon{+wh,+wt} WCon{+blh,+blt} 0n:
          F.left(B.row_valid(B.Row{ph,nh,bh,rh,qh,kh,wh,blh}),B.words(t,pt,nt,bt,rt,qt,kt,wt,blt),good)
        case WCon{+ph,+pt} WCon{+nh,+nt} WCon{+bh,+bt} WCon{+rh,+rt} WCon{+qh,+qt} WCon{+kh,+kt} WCon{+wh,+wt} WCon{+blh,+blt} 1n+j:
          project(t,pt,nt,bt,rt,qt,kt,wt,blt,j,F.right(B.row_valid(B.Row{ph,nh,bh,rh,qh,kh,wh,blh}),B.words(t,pt,nt,bt,rt,qt,kt,wt,blt),good))

def valid_mix(+choice: Bool,+a: B.Row,+b: B.Row,
  ga: {B.row_valid(a) == True{} : Bool},gb: {B.row_valid(b) == True{} : Bool}) ->
  {B.row_valid(S.mix(choice,a,b)) == True{} : Bool}:
  match choice a b:
    case True{} B.Row{ap,an,ab,ar,aq,ak,aw,abl} B.Row{bp,bn,bb,br,bq,bk,bw,bbl}: ga
    case False{} B.Row{ap,an,ab,ar,aq,ak,aw,abl} B.Row{bp,bn,bb,br,bq,bk,bw,bbl}: gb

def structural(+board: Chess.Board,+sq: U32,+good: {B.valid(board) == True{} : Bool}) ->
  {B.row_valid(S.structural(board,sq)) == True{} : Bool}:
  match board:
    case Chess.Board{U64{U32{+pl},U32{+ph}},U64{U32{+nl},U32{+nh}},U64{U32{+bl},U32{+bh}},U64{U32{+rl},U32{+rh}},U64{U32{+ql},U32{+qh}},U64{U32{+kl},U32{+kh}},U64{U32{+wl},U32{+wh}},U64{U32{+bll},U32{+blh}},turn,rights,ep}:
      valid_mix(Nat.is_lt(U32.to_nat(sq),32n),S.word_row(32n,pl,nl,bl,rl,ql,kl,wl,bll,U32.to_nat(sq)),S.word_row(32n,ph,nh,bh,rh,qh,kh,wh,blh,Nat.sub(U32.to_nat(sq),32n)),
        project(32n,pl,nl,bl,rl,ql,kl,wl,bll,U32.to_nat(sq),F.left(B.words(32n,pl,nl,bl,rl,ql,kl,wl,bll),B.words(32n,ph,nh,bh,rh,qh,kh,wh,blh),good)),
        project(32n,ph,nh,bh,rh,qh,kh,wh,blh,Nat.sub(U32.to_nat(sq),32n),F.right(B.words(32n,pl,nl,bl,rl,ql,kl,wl,bll),B.words(32n,ph,nh,bh,rh,qh,kh,wh,blh),good)))

def observations(+board: Chess.Board,+sq: U32,+bound: {Nat.is_lt(U32.to_nat(sq),64n) == True{} : Bool}) ->
  {S.row(board,sq) == S.structural(board,sq) : B.Row}:
  match board:
    case Chess.Board{+p,+n,+b,+r,+q,+k,+w,+bl,turn,rights,ep}:
      Equal.trans(B.Row,B.Row{U64.test_bit(p,U32.to_nat(sq)),U64.test_bit(n,U32.to_nat(sq)),U64.test_bit(b,U32.to_nat(sq)),U64.test_bit(r,U32.to_nat(sq)),U64.test_bit(q,U32.to_nat(sq)),U64.test_bit(k,U32.to_nat(sq)),U64.test_bit(w,U32.to_nat(sq)),U64.test_bit(bl,U32.to_nat(sq))},B.Row{Bits.get64(p,U32.to_nat(sq)),U64.test_bit(n,U32.to_nat(sq)),U64.test_bit(b,U32.to_nat(sq)),U64.test_bit(r,U32.to_nat(sq)),U64.test_bit(q,U32.to_nat(sq)),U64.test_bit(k,U32.to_nat(sq)),U64.test_bit(w,U32.to_nat(sq)),U64.test_bit(bl,U32.to_nat(sq))},B.Row{Bits.get64(p,U32.to_nat(sq)),Bits.get64(n,U32.to_nat(sq)),Bits.get64(b,U32.to_nat(sq)),Bits.get64(r,U32.to_nat(sq)),Bits.get64(q,U32.to_nat(sq)),Bits.get64(k,U32.to_nat(sq)),Bits.get64(w,U32.to_nat(sq)),Bits.get64(bl,U32.to_nat(sq))},Equal.cong(Bool,B.Row,v => B.Row{v,U64.test_bit(n,U32.to_nat(sq)),U64.test_bit(b,U32.to_nat(sq)),U64.test_bit(r,U32.to_nat(sq)),U64.test_bit(q,U32.to_nat(sq)),U64.test_bit(k,U32.to_nat(sq)),U64.test_bit(w,U32.to_nat(sq)),U64.test_bit(bl,U32.to_nat(sq))},U64.test_bit(p,U32.to_nat(sq)),Bits.get64(p,U32.to_nat(sq)),Bits.test64(p,U32.to_nat(sq),bound)),
        Equal.trans(B.Row,B.Row{Bits.get64(p,U32.to_nat(sq)),U64.test_bit(n,U32.to_nat(sq)),U64.test_bit(b,U32.to_nat(sq)),U64.test_bit(r,U32.to_nat(sq)),U64.test_bit(q,U32.to_nat(sq)),U64.test_bit(k,U32.to_nat(sq)),U64.test_bit(w,U32.to_nat(sq)),U64.test_bit(bl,U32.to_nat(sq))},B.Row{Bits.get64(p,U32.to_nat(sq)),Bits.get64(n,U32.to_nat(sq)),U64.test_bit(b,U32.to_nat(sq)),U64.test_bit(r,U32.to_nat(sq)),U64.test_bit(q,U32.to_nat(sq)),U64.test_bit(k,U32.to_nat(sq)),U64.test_bit(w,U32.to_nat(sq)),U64.test_bit(bl,U32.to_nat(sq))},B.Row{Bits.get64(p,U32.to_nat(sq)),Bits.get64(n,U32.to_nat(sq)),Bits.get64(b,U32.to_nat(sq)),Bits.get64(r,U32.to_nat(sq)),Bits.get64(q,U32.to_nat(sq)),Bits.get64(k,U32.to_nat(sq)),Bits.get64(w,U32.to_nat(sq)),Bits.get64(bl,U32.to_nat(sq))},Equal.cong(Bool,B.Row,v => B.Row{Bits.get64(p,U32.to_nat(sq)),v,U64.test_bit(b,U32.to_nat(sq)),U64.test_bit(r,U32.to_nat(sq)),U64.test_bit(q,U32.to_nat(sq)),U64.test_bit(k,U32.to_nat(sq)),U64.test_bit(w,U32.to_nat(sq)),U64.test_bit(bl,U32.to_nat(sq))},U64.test_bit(n,U32.to_nat(sq)),Bits.get64(n,U32.to_nat(sq)),Bits.test64(n,U32.to_nat(sq),bound)),
