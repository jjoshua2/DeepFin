def left(row: B.Row,proof: statement(row)) -> {S.encode(S.classify(row)) == row : B.Row}:
  (roundtrip,decode) = proof
  roundtrip

def right(row: B.Row,proof: statement(row)) -> {S.local_decode(row) == S.classify(row) : S.Cell}:
  (roundtrip,decode) = proof
  decode

def roundtrip(+row: B.Row,good: {B.row_valid(row) == True{} : Bool}) -> {S.encode(S.classify(row)) == row : B.Row}:
  left(row,checked(row,good))

def decode(+row: B.Row,good: {B.row_valid(row) == True{} : Bool}) -> {S.local_decode(row) == S.classify(row) : S.Cell}:
  right(row,checked(row,good))
