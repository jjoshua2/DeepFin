# Finite proof of the independent thirteen-state square model.
import Base
import ./Spec.bend as S
import ../board/Spec.bend as B
import ../u64/Words.bend as Old

def statement(+row: B.Row) -> Type:
  {S.encode(S.classify(row)) == row : B.Row} & {S.local_decode(row) == S.classify(row) : S.Cell}

def checked(+row: B.Row,good: {B.row_valid(row) == True{} : Bool}) -> statement(row):
