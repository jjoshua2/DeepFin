    case 64n+p: Domain.impossible(step(64n+p),p,e)

def current(+n: Nat,+k: Nat,e: {Nat.is_le(Nat.add(1n+n,k),64n) == True{} : Bool}) ->
  {Nat.is_lt(k,64n) == True{} : Bool}:
  Nats.strip(n,k,64n,Equal.trans(Bool,Nat.is_lt(Nat.add(n,k),64n),Nat.is_le(1n+Nat.add(n,k),64n),True{},
    Equal.sym(Bool,Nat.is_le(1n+Nat.add(n,k),64n),Nat.is_lt(Nat.add(n,k),64n),Naturals.suc_le(Nat.add(n,k),64n)),e))

def tail(+n: Nat,+k: Nat,e: {Nat.is_le(Nat.add(1n+n,k),64n) == True{} : Bool}) ->
  {Nat.is_le(Nat.add(n,1n+k),64n) == True{} : Bool}:
  Equal.trans(Bool,Nat.is_le(Nat.add(n,1n+k),64n),Nat.is_le(1n+Nat.add(n,k),64n),True{},
    Equal.cong(Nat,Bool,x => Nat.is_le(x,64n),Nat.add(n,1n+k),1n+Nat.add(n,k),Nats.add_suc(n,k)),e)
