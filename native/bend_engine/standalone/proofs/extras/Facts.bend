# All 64 square cases are discharged by the source checker, not an answer table.
import Base
import ../layout/Domain.bend as Domain
import ../prefix/Nats.bend as Nats
import ../fill_interval/Naturals.bend as Naturals

def bounds(+i: U32) -> Type:
  {U32.is_le(256,i) == True{} : Bool} & {U32.is_lt(i,512) == True{} : Bool}

def step(+k: Nat) -> Type:
  {U32.inc(U32.from_nat(k)) == U32.from_nat(1n+k) : U32}
  & bounds(U32.add(256,U32.from_nat(k)))
  & bounds(U32.add(320,U32.from_nat(k)))
  & bounds(U32.add(384,U32.from_nat(k)))
  & bounds(U32.add(448,U32.from_nat(k)))

def square(+k: Nat,e: {Nat.is_lt(k,64n) == True{} : Bool}) -> step(k):
  match k:
    case 0n: ({==}, (({==},{==}), (({==},{==}), (({==},{==}), ({==},{==})))))
    case 1n: ({==}, (({==},{==}), (({==},{==}), (({==},{==}), ({==},{==})))))
    case 2n: ({==}, (({==},{==}), (({==},{==}), (({==},{==}), ({==},{==})))))
