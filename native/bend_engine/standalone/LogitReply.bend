# Neural logits -> legal priors / WDL, entirely in Bend. No model or IO here.
# All 1858 policy logits and all three WDL logits must be finite before use.
# Array capacity is NOT the output shape. Missing/extra words are rejected.
import Base
import ../legal_probe/Chess.bend as Chess
import ../session_probe/Search.bend as Search
import ./Policy.bend as Policy

type Decoded is Type:
  BadOutput{}
  Logits{values: Array<F32>}

def finite(x: F32) -> Bool:
  Bool.not(U32.is_eq(U32.and(F32.bits(x), 2139095040), 2139095040))

def finished(xs: List<F32>, a: Array<F32>, valid: Bool) -> Decoded:
  match xs:
    case Nil{}:
      match valid:
        case True{}: Logits{a}
        case False{}: BadOutput{}
    case _: BadOutput{}

def decode(fuel: Nat, +i: U32, xs: List<F32>, a: Array<F32>, valid: Bool) -> Decoded:
  match fuel:
    case 0n: finished(xs, a, valid)
    case 1n+p:
      match xs:
        case Nil{}: BadOutput{}
        case Con{+v, rest}:
          decode(p, U32.inc(i), rest, Array.set(F32, a, i, v), Bool.and(valid, finite(v)))

# Entries are generated by Policy from the same validated Game. Require their
# order AND exact flags to agree with the outstanding ticket before gathering.
def aligned(entries: List<&2, Policy.Entry>, moves: List<&2, Chess.Ply>) -> Bool:
  match entries moves:
    case Nil{} Nil{}: True{}
    case Con{Policy.Entry{+m, full, +slot}, es} Con{other, ms}:
      Bool.and(U32.is_lt(slot, 1858), Bool.and(U32.is_eq(Search.key(m), Search.key(other)), aligned(es, ms)))
    case _ _: False{}

type Gather is Type:
  Gather{logits: Array<F32>, policy: Array<F32>}

def gathered(i: U32, policy: Array<F32>, r: Array<F32> & F32) -> Gather:
  (logits, value) = r
  Gather{logits, Array.set(F32, policy, i, value)}

def gather(entries: List<&2, Policy.Entry>, +i: U32, g: Gather) -> Gather:
  match entries:
    case Nil{}: g
    case Con{Policy.Entry{move, full, slot}, rest}:
      Gather{logits, policy} = g
      gather(rest, U32.inc(i), gathered(i, policy, Array.get(F32, logits, slot)))

def max_seen(value: F32, r: Array<F32> & F32) -> Array<F32> & F32:
  (a, v) = r
  (a, F32.max(value, v))

def maximum(fuel: Nat, +i: U32, r: Array<F32> & F32) -> Array<F32> & F32:
  match fuel:
    case 0n: r
    case 1n+p:
      (a, v) = r
      maximum(p, U32.inc(i), max_seen(v, Array.get(F32, a, i)))

def exp_seen(+i: U32, max: F32, sum: F32, r: Array<F32> & F32) -> Array<F32> & F32:
  (a, x) = r
  +v = F32.exp(F32.sub(x, max))
  (Array.set(F32, a, i, v), F32.add(sum, v))

def exponentiate(fuel: Nat, +i: U32, +max: F32, r: Array<F32> & F32) -> Array<F32> & F32:
  match fuel:
    case 0n: r
    case 1n+p:
      (a, sum) = r
      exponentiate(p, U32.inc(i), max, exp_seen(i, max, sum, Array.get(F32, a, i)))

def div_seen(i: U32, sum: F32, r: Array<F32> & F32) -> Array<F32>:
  (a, x) = r
  Array.set(F32, a, i, F32.div(x, sum))

def divide(fuel: Nat, +i: U32, +sum: F32, a: Array<F32>) -> Array<F32>:
  match fuel:
    case 0n: a
    case 1n+p: divide(p, U32.inc(i), sum, div_seen(i, sum, Array.get(F32, a, i)))

def softmax_sum(n: Nat, r: Array<F32> & F32) -> Array<F32>:
  (a, sum) = r
  divide(n, 0, sum, a)

def softmax_max(+n: Nat, r: Array<F32> & F32) -> Array<F32>:
  (a, max) = r
  softmax_sum(n, exponentiate(n, 0, max, (a, 0.0)))

# Private: n is nonzero and all n entries were finite. Subtracting the maximum
# permits negative overflow to -inf (exp=0), but never positive exp overflow.
def softmax(+n: Nat, a: Array<F32>) -> Array<F32>:
  softmax_max(n, maximum(n, 0, Array.get(F32, a, 0)))

def wdl_copy(i: U32, out: Array<F32>, r: Array<F32> & F32) -> Array<F32> & Array<F32>:
  (src, x) = r
  (src, Array.set(F32, out, i, x))

def wdl_collect(fuel: Nat, +i: U32, r: Array<F32> & Array<F32>) -> Array<F32>:
  match fuel:
    case 0n:
      (src, out) = r
      out
    case 1n+p:
      (src, out) = r
      wdl_collect(p, U32.inc(i), wdl_copy(i, out, Array.get(F32, src, U32.add(1858, i))))

def with_loss(epoch: U32, request: U32, node: U32, count: U32,
  policy: Array<F32>, win: F32, draw: F32, r: Array<F32> & F32) -> Search.Reply:
  (wdl, loss) = r
  Search.Reply{epoch, request, node, 0, win, draw, loss, count, policy}

def with_draw(epoch: U32, request: U32, node: U32, count: U32,
  policy: Array<F32>, win: F32, r: Array<F32> & F32) -> Search.Reply:
  (wdl, draw) = r
  with_loss(epoch, request, node, count, policy, win, draw, Array.get(F32, wdl, 2))

def with_win(epoch: U32, request: U32, node: U32, count: U32,
  policy: Array<F32>, r: Array<F32> & F32) -> Search.Reply:
  (wdl, win) = r
  with_draw(epoch, request, node, count, policy, win, Array.get(F32, wdl, 1))

def probabilities(epoch: U32, request: U32, node: U32, +count: U32, g: Gather) -> Search.Reply:
  Gather{logits, policy} = g
  wdl = softmax(3n, wdl_collect(3n, 0, (logits, Array.new(F32, 2n, 0.0))))
  with_win(epoch, request, node, count, softmax(U32.to_nat(count), policy), Array.get(F32, wdl, 0))

def failed(epoch: U32, request: U32, node: U32) -> Search.Reply:
  Search.Reply{epoch, request, node, 1, 0.0, 0.0, 0.0, 0, Array.new(F32, 8n, 0.0)}

def validated(ok: Bool, epoch: U32, request: U32, node: U32, count: U32,
  entries: List<&2, Policy.Entry>, decoded: Decoded) -> Search.Reply:
  match ok decoded:
    case True{} Logits{logits}:
      probabilities(epoch, request, node, count, gather(entries, 0, Gather{logits, Array.new(F32, 8n, 0.0)}))
    case _ _: failed(epoch, request, node)

def convert(ticket: Search.Ticket, +entries: List<&2, Policy.Entry>, output: List<F32>) -> Search.Reply:
  Search.Ticket{epoch, request, node, board, moves, needs} = ticket
  +count = U32.from_nat(List.length(&2, Policy.Entry, entries))
  validated(Bool.and(needs, Bool.and(U32.is_gt(count, 0), Bool.and(U32.is_le(count, 256), aligned(entries, moves)))),
    epoch, request, node, count, entries, decode(1861n, 0, output, Array.new(F32, 11n, 0.0), True{}))

# Reusable native output. Retain storage through validation, gathering and WDL
# extraction; the tree owns only the newly built legal policy, never these logits.
type Converted is Type:
  Converted{values: Array<F32>, reply: Search.Reply}

def finite_seen(valid: Bool, r: Array<F32> & F32) -> Array<F32> & Bool:
  (values, x) = r
  (values, Bool.and(valid, finite(x)))

def finite_buffer(fuel: Nat, +i: U32, r: Array<F32> & Bool) -> Array<F32> & Bool:
  match fuel:
    case 0n: r
    case 1n+p:
      (values, valid) = r
      finite_buffer(p, U32.inc(i), finite_seen(valid, Array.get(F32, values, i)))

def wdl_buffer(fuel: Nat, +i: U32, r: Array<F32> & Array<F32>) -> Array<F32> & Array<F32>:
  match fuel:
    case 0n: r
    case 1n+p:
      (src, out) = r
      wdl_buffer(p, U32.inc(i), wdl_copy(i, out, Array.get(F32, src, U32.add(1858, i))))

def probabilities_collected(epoch: U32, request: U32, node: U32, +count: U32,
  policy: Array<F32>, r: Array<F32> & Array<F32>) -> Converted:
  (logits, wdl) = r
  Converted{logits, with_win(epoch, request, node, count, softmax(U32.to_nat(count), policy),
    Array.get(F32, softmax(3n, wdl), 0))}

def probabilities_buffer(epoch: U32, request: U32, node: U32, count: U32, g: Gather) -> Converted:
  Gather{logits, policy} = g
  probabilities_collected(epoch, request, node, count, policy, wdl_buffer(3n, 0, (logits, Array.new(F32, 2n, 0.0))))

def validated_buffer(epoch: U32, request: U32, node: U32, count: U32,
  entries: List<&2, Policy.Entry>, r: Array<F32> & Bool) -> Converted:
  (values, ok) = r
  match ok:
    case False{}: Converted{values, failed(epoch, request, node)}
    case True{}: probabilities_buffer(epoch, request, node, count,
      gather(entries, 0, Gather{values, Array.new(F32, 8n, 0.0)}))

def failed_buffer(ticket: Search.Ticket, values: Array<F32>) -> Converted:
  Search.Ticket{epoch, request, node, board, moves, needs} = ticket
  Converted{values, failed(epoch, request, node)}

def checked_buffer(ticket: Search.Ticket, +entries: List<&2, Policy.Entry>, values: Array<F32>) -> Converted:
  Search.Ticket{epoch, request, node, board, moves, needs} = ticket
  +count = U32.from_nat(List.length(&2, Policy.Entry, entries))
  valid = Bool.and(needs, Bool.and(U32.is_gt(count, 0), Bool.and(U32.is_le(count, 256), aligned(entries, moves))))
  validated_buffer(epoch, request, node, count, entries, finite_buffer(1861n, 0, (values, valid)))

def shaped_buffer(ok: Bool, ticket: Search.Ticket, entries: List<&2, Policy.Entry>, values: Array<F32>) -> Converted:
  match ok:
    case False{}: failed_buffer(ticket, values)
    case True{}: checked_buffer(ticket, entries, values)

def convert_buffer(ticket: Search.Ticket, entries: List<&2, Policy.Entry>, count: U32,
  r: Array<F32> & U32) -> Converted:
  (values, capacity) = r
  shaped_buffer(Bool.and(U32.is_eq(count, 1861), U32.is_eq(capacity, 2048)), ticket, entries, values)
