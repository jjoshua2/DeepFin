# Local backups/merged scratch files
*.bak
*.merged
*.merged.*

# Scratch docs (canonical future_ideas.md and docs/archive/{spec,prompt}.md stay tracked)
prompt2
prompt.md.*
spec2
spec.md.*

# Fuzzing build artifacts
scripts/fuzz/cboard_fuzz
scripts/fuzz/corpus/
scripts/fuzz/crash-*
crash-*

# Credentials. ⚑ NEVER TRACK A SECRET -- this repo is public, and a secret
# committed once stays in the history after any edit (see server/secrets.py).
.secrets/
*.password
.env
.env.*
.ratchet_disabled
.monitor_fen_disabled

# scratchpad/ is untracked local scratch (see scratchpad/README.md). Its old
# tracked content is archived (tag pre-slim-20261113). Re-included below: the
# README and the few files staying code or current docs still read.
/scratchpad/*
!/scratchpad/README.md
!/scratchpad/seed_shift_control.py
!/scratchpad/fpr_measure.py
!/scratchpad/bt4/
/scratchpad/bt4/*
!/scratchpad/bt4/inspect_bt4.py
!/scratchpad/bt4_joint20/
/scratchpad/bt4_joint20/*
!/scratchpad/bt4_joint20/sf_close_run02/
/scratchpad/bt4_joint20/sf_close_run02/*
!/scratchpad/bt4_joint20/sf_close_run02/completed_s100_readout.json
!/scratchpad/bt4_joint20/sf_close_run02/optional_sharpened_ties_data_qualification.json
!/scratchpad/bt4_joint20/sf_close_run02/sf-close/
/scratchpad/bt4_joint20/sf_close_run02/sf-close/*
